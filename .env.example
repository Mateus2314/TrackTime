# ========================================
# DATABASE CONFIGURATION
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracktime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracktime

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# For local development, you can use Supabase cloud or local
# Get these keys from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# API CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ========================================
# FACIAL RECOGNITION (optional - configure later)
# ========================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# REKOGNITION_COLLECTION_ID=tracktime-faces

# OR Azure Face API
# AZURE_FACE_API_KEY=your-azure-key
# AZURE_FACE_API_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# ========================================
# PUSH NOTIFICATIONS (optional - configure later)
# ========================================
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ========================================
# FILE STORAGE
# ========================================
# Storage for facial images, profile pics, etc
STORAGE_PROVIDER=supabase
# or 'local' for development

# ========================================
# CORS
# ========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=debug
